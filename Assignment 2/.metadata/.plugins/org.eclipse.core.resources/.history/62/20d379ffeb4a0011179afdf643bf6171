/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdio.h>
#include <string.h>

/* Private typedef -----------------------------------------------------------*/
typedef struct
{
    const char *name;
    uint32_t arr;
    uint32_t dur;
} Note;

/* Private define ------------------------------------------------------------*/
#define MELODY_LEN 13
#define SCALE_LEN 8

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim4;
UART_HandleTypeDef huart2;

volatile uint32_t ms_count = 0;

/* Note Data Tables */
static const Note scale[SCALE_LEN] = {
    { "C4", 3436, 400 }, { "D4", 3061, 400 }, { "E4", 2727, 400 }, { "F4", 2572, 400 },
    { "G4", 2295, 400 }, { "A4", 2044, 400 }, { "B4", 1821, 400 }, { "C5", 1717, 400 }
};

static const Note melody[MELODY_LEN] = {
    { "E5",  1364, 150 }, { "D5",  1532, 150 }, { "FS4", 2431, 300 }, { "G4",  2295, 300 },
    { "C5",  1717, 150 }, { "B4",  1821, 150 }, { "D4",  3061, 300 }, { "E4",  2727, 300 },
    { "B4",  1821, 150 }, { "A4",  2044, 150 }, { "C4",  3436, 300 }, { "E4",  2727, 300 },
    { "A4",  2044, 600 }
};

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);
static void MX_TIM4_Init(void);
static void MX_USART2_UART_Init(void);
void Error_Handler(void);

/* Helper Functions ----------------------------------------------------------*/
void delay_ms(uint32_t ms) {
    uint32_t start = ms_count;
    while((ms_count - start) < ms);
}

void PlayNote(uint32_t arr, uint32_t duration) {
    __HAL_TIM_SET_AUTORELOAD(&htim4, arr);
    __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, arr / 2);

    // Force immediate update to shadow registers (matches Bare-Metal EGR_UG)
    htim4.Instance->EGR = TIM_EGR_UG;

    delay_ms(duration);
    __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, 0);
}

void REST(uint32_t ms) {
    __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, 0);
    delay_ms(ms);
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if(htim->Instance == TIM2) {
        ms_count++;
    }
}

/* Main Program --------------------------------------------------------------*/
int main(void)
{
    char buf[100];
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_TIM2_Init();
    MX_TIM4_Init();
    MX_USART2_UART_Init();

    HAL_TIM_Base_Start_IT(&htim2);
    HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);

    // --- Part 1: C-Major Scale (Once) ---
    strcpy(buf, "\r\n-- Part 1: C-Major Scale --\r\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);

    for (uint8_t i = 0; i < SCALE_LEN; i++) {
        snprintf(buf, sizeof(buf), "%s ARR=%lu\r\n", scale[i].name, scale[i].arr);
        HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);
        PlayNote(scale[i].arr, scale[i].dur);
        REST(50);
    }

    delay_ms(1000);

    // --- Part 2: Nokia Tune (Loop) ---
    while (1)
    {
        strcpy(buf, "\r\n=== Nokia Tune Start ===\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);

        for(uint8_t i = 0; i < MELODY_LEN; i++) {
            snprintf(buf, sizeof(buf), "%s ARR=%lu DUR=%lu\r\n",
                     melody[i].name, melody[i].arr, melody[i].dur);
            HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);
            PlayNote(melody[i].arr, melody[i].dur);
            REST(40);
        }
        delay_ms(2000);
    }
}

