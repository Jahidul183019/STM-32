/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdio.h>
#include <string.h>

/* Private typedef -----------------------------------------------------------*/
typedef struct {
    const char *name;
    uint32_t    arr;
    uint32_t    dur;
} Note;

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim2;  // 1ms Tick Timer
TIM_HandleTypeDef htim4;  // Buzzer PWM Timer
UART_HandleTypeDef huart2;

volatile uint32_t ms_count = 0;

/* Note Data Tables */
static const Note scale[] = {
    { "C4", 3436, 400 }, { "D4", 3061, 400 }, { "E4", 2727, 400 }, { "F4", 2572, 400 },
    { "G4", 2295, 400 }, { "A4", 2044, 400 }, { "B4", 1821, 400 }, { "C5", 1717, 400 }
};

static const Note melody[] = {
    { "E5", 1364, 150 }, { "D5", 1532, 150 }, { "F4", 2572, 300 }, { "G4", 2295, 300 },
    { "C5", 1717, 150 }, { "B4", 1821, 150 }, { "D4", 3061, 300 }, { "E4", 2727, 300 },
    { "B4", 1821, 150 }, { "A4", 2044, 150 }, { "C4", 3436, 300 }, { "E4", 2727, 300 },
    { "A4", 2044, 600 }
};

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_TIM2_Init(void);
static void MX_TIM4_Init(void);

/* Helper Functions ----------------------------------------------------------*/

/**
 * @brief  Custom millisecond delay using TIM2 ISR counter.
 */
void delay_ms(uint32_t ms) {
    uint32_t start = ms_count;
    while ((ms_count - start) < ms);
}

/**
 * @brief  Play a note by adjusting TIM4 ARR on the fly.
 */
void PlayNote(uint32_t arr, uint32_t duration) {
    // 1. Set the auto-reload value (frequency)
    __HAL_TIM_SET_AUTORELOAD(&htim4, arr);

    // 2. Set 50% duty cycle (CCR = ARR / 2)
    __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, arr / 2);

    // 3. Force immediate update of shadow registers (EGR_UG)
    htim4.Instance->EGR = TIM_EGR_UG;

    // 4. Start PWM
    HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);

    delay_ms(duration);

    // 5. Silence (Stop PWM)
    HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_1);
}

void REST(uint32_t duration) {
    HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_1);
    delay_ms(duration);
}

/**
 * @brief  TIM2 Interrupt Callback (Increments ms_count)
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        ms_count++;
    }
}

/* Main Application ----------------------------------------------------------*/

int main(void) {
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_TIM2_Init();
    MX_TIM4_Init();

    char buf[100];

    // Start TIM2 for the 1ms Interrupt
    HAL_TIM_Base_Start_IT(&htim2);

    /* --- Part 1: C-Major Scale --- */
    sprintf(buf, "\r\n-- Part 1: C-Major Scale --\r\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);

    for (int i = 0; i < 8; i++) {
        PlayNote(scale[i].arr, scale[i].dur);
        delay_ms(50);
    }

    delay_ms(1000); // Wait 1 second

    /* --- Part 2: Nokia Tune --- */
    sprintf(buf, "-- Part 2: Nokia Tune --\r\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 100);

    for (int i = 0; i < 13; i++) {
        PlayNote(melody[i].arr, melody[i].dur);
        REST(40);
    }

    while (1);
}

/* Peripheral Initialization -------------------------------------------------*/

/**
  * @brief TIM2 Initialization (1ms Tick)
  * Prescaler = 89, Period = 999 (90MHz / 90 / 1000 = 1kHz)
  */
static void MX_TIM2_Init(void) {
    htim2.Instance = TIM2;
    htim2.Init.Prescaler = 89;
    htim2.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim2.Init.Period = 999;
    htim2.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim2.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;
    HAL_TIM_Base_Init(&htim2);
}

/**
  * @brief TIM4 Initialization (Buzzer PWM)
  * Prescaler = 99 (90MHz / 100 = 900kHz tick)
  */
static void MX_TIM4_Init(void) {
    TIM_OC_InitTypeDef sConfigOC = {0};
    htim4.Instance = TIM4;
    htim4.Init.Prescaler = 99;
    htim4.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim4.Init.Period = 999; // Placeholder
    htim4.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim4.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
    HAL_TIM_PWM_Init(&htim4);

    sConfigOC.OCMode = TIM_OCMODE_PWM1;
    sConfigOC.Pulse = 0;
    sConfigOC.OCPolarity = TIM_OCPOLARITY_HIGH;
    sConfigOC.OCFastMode = TIM_OCFAST_DISABLE;
    HAL_TIM_PWM_ConfigChannel(&htim4, &sConfigOC, TIM_CHANNEL_1);
}

