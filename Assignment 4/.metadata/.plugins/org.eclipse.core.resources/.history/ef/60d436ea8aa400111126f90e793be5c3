/* ============================================================
 *  Flash utilities — HAL equivalents of Milestone B
 *  (Compare against the register-level Flash_Unlock/Flash_Lock/
 *  Flash_EraseSector/Flash_WriteWord in the bare-metal build — HAL
 *  hides the FLASH_CR bit twiddling behind these two calls.)
 * ============================================================ */

/**
 * @brief  Erase one Flash sector via HAL_FLASHEx_Erase(). Unlock/lock
 *         are handled per-call so the interface is never left open
 *         longer than necessary. Internally this still performs the
 *         same SER/SNB/STRT/BSY sequence as the register-level
 *         version — HAL just does it for you.
 * @param  sectorMacro  FLASH_SECTOR_6 or FLASH_SECTOR_7.
 */
static void Flash_EraseSector_HAL(uint32_t sectorMacro)
{
  FLASH_EraseInitTypeDef eraseInit;
  uint32_t sectorError;

  HAL_FLASH_Unlock();

  eraseInit.TypeErase    = FLASH_TYPEERASE_SECTORS;
  eraseInit.Sector       = sectorMacro;
  eraseInit.NbSectors    = 1;
  eraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3; /* 2.7-3.6V, allows word programming */

  HAL_FLASHEx_Erase(&eraseInit, &sectorError);

  HAL_FLASH_Lock();
}

/**
 * @brief  Program a single 32-bit word via HAL_FLASH_Program().
 *         Internally sets PSIZE/PG the same way the register-level
 *         Flash_WriteWord() does.
 */
static void Flash_WriteWord_HAL(uint32_t addr, uint32_t data)
{
  HAL_FLASH_Unlock();
  HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, addr, data);
  HAL_FLASH_Lock();
}

/**
 * @brief  Flash is memory-mapped, so reads never need HAL at all —
 *         a direct volatile pointer dereference is sufficient, same
 *         as the register-level Flash_ReadWord().
 */
static uint32_t Flash_ReadWord_HAL(uint32_t addr)
{
  return *(volatile uint32_t *)addr;
}

/**
 * @brief  Write an arbitrary-length block of words, one
 *         Flash_WriteWord_HAL() call per word. Used for both the
 *         StudentInfo_t and ResultsBlock_t structs.
 */
static void Flash_WriteBlock_HAL(uint32_t addr, const uint32_t *data, uint32_t nwords)
{
  for (uint32_t i = 0U; i < nwords; i++)
  {
    Flash_WriteWord_HAL(addr + (i * 4U), data[i]);
  }
}

/**
 * @brief  Milestone B checkpoint (TC2/TC3): erase Sector 7, confirm
 *         erased read-back, write+verify a known pattern, re-erase.
 * @return 1 if every check passed, 0 on the first mismatch.
 */
static uint8_t Flash_SelfTest_HAL(void)
{
  Flash_EraseSector_HAL(RESULTS_SECTOR);
  if (Flash_ReadWord_HAL(RESULTS_BASE) != ERASED_WORD) return 0U;

  Flash_WriteWord_HAL(RESULTS_BASE, 0xDEADBEEFU);
  if (Flash_ReadWord_HAL(RESULTS_BASE) != 0xDEADBEEFU) return 0U;

  Flash_EraseSector_HAL(RESULTS_SECTOR);
  return 1U;
}

